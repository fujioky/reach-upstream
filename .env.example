AGENT_REACH_PROXY_HOST=127.0.0.1
AGENT_REACH_PROXY_PORT=18280
# Origin the proxy is reachable at from the outside (tunnel / reverse proxy).
# Only used to build MCP OAuth metadata; the HTTP endpoint does not need it.
AGENT_REACH_PROXY_PUBLIC_URL=http://127.0.0.1:18280
# Required. Shared password for /http/?pwd=... — the proxy refuses requests until it is set.
AGENT_REACH_PROXY_PASSWORD=change-me
# MCP bearer token; falls back to AGENT_REACH_PROXY_PASSWORD when empty.
AGENT_REACH_MCP_TOKEN=
AGENT_REACH_MCP_AUTH_REQUIRED=1
AGENT_REACH_MCP_OAUTH_TOKEN_TTL=7776000
AGENT_REACH_TURNSTILE_SITE_KEY=
AGENT_REACH_TURNSTILE_SECRET_KEY=
AGENT_REACH_PROXY_SEARCH_LIMIT=15
AGENT_REACH_PROXY_COMMENT_LIMIT=50
AGENT_REACH_MCP_IMAGE_MAX_BYTES=4000000
AGENT_REACH_MCP_IMAGE_DOWNLOAD_MAX_BYTES=32000000
AGENT_REACH_XHS_INLINE_IMAGE_LIMIT=30
AGENT_REACH_XHS_IMAGE_DEDUPE_DISTANCE=4
# X: twitter-cli reads these first; take auth_token and ct0 from a logged-in x.com browser session.
TWITTER_AUTH_TOKEN=
TWITTER_CT0=
# Telegram (optional): an app from https://my.telegram.org plus a user-session file (see README).
AGENT_REACH_TG_API_ID=
AGENT_REACH_TG_API_HASH=
AGENT_REACH_TG_SESSION=runtime/telegram/reach.session
